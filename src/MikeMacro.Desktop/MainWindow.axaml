<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MikeMacro.Desktop.MainWindow"
        Title="MikeMacro"
        Width="900"
        Height="600"
        MinWidth="640"
        MinHeight="420">
  <Grid RowDefinitions="Auto,*,Auto" Margin="24">
    <StackPanel Spacing="4">
      <TextBlock Text="MikeMacro" FontSize="28" FontWeight="SemiBold" />
      <TextBlock Text="Portable macro workspace" Opacity="0.7" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="220,*" Margin="0,24,0,18">
      <Border Background="#20242B" CornerRadius="8" Padding="14">
        <StackPanel Spacing="10">
          <TextBlock Text="MACROS" FontSize="12" FontWeight="Bold" Opacity="0.7" />
          <Button Content="Demo sequence" HorizontalContentAlignment="Left" />
          <Button Content="+ New macro" HorizontalContentAlignment="Left" />
        </StackPanel>
      </Border>

      <Border Grid.Column="1" BorderBrush="#3A414C" BorderThickness="1" CornerRadius="8" Padding="18" Margin="18,0,0,0">
        <Grid RowDefinitions="Auto,*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Demo sequence" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="2 actions" VerticalAlignment="Center" Opacity="0.65" />
          </StackPanel>
          <ItemsControl Grid.Row="1" ItemsSource="{Binding Actions}" Margin="0,14,0,14">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="#262C35" CornerRadius="5" Padding="12" Margin="0,0,0,8">
                  <TextBlock Text="{Binding}" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Grid.Row="2" Text="{Binding Status}" Opacity="0.7" />
        </Grid>
      </Border>
    </Grid>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
      <Button x:Name="RecordButton" Content="Record" Click="RecordClick" Padding="16,9" />
      <Button x:Name="StopRecordingButton" Content="Stop recording" Click="StopRecordingClick" IsEnabled="False" Padding="16,9" />
      <Button Content="Preview safely" Click="PreviewClick" Padding="16,9" />
      <Button Content="Play" IsEnabled="False" Padding="16,9" />
    </StackPanel>
  </Grid>
</Window>